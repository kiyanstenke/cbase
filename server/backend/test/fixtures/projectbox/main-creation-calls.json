[
  [
    "image",
    "inspect",
    "--format",
    "{{.Id}}",
    "cbase-projectbox:latest"
  ],
  [
    "inspect",
    "--type",
    "container",
    "cbase-p-<pid>"
  ],
  [
    "network",
    "inspect",
    "cbase-pn-<pid>"
  ],
  [
    "network",
    "ls",
    "-q",
    "--no-trunc"
  ],
  [
    "network",
    "create",
    "--driver",
    "bridge",
    "--subnet",
    "10.230.0.0/24",
    "--gateway",
    "10.230.0.1",
    "-o",
    "com.docker.network.bridge.name=cbp-0",
    "--label",
    "cbase.project=<pid>",
    "--label",
    "cbase.instance=main",
    "cbase-pn-<pid>"
  ],
  [
    "volume",
    "create",
    "--label",
    "cbase.project=<pid>",
    "--label",
    "cbase.instance=main",
    "cbase-p-<pid>-docker"
  ],
  [
    "run",
    "-d",
    "--privileged",
    "--restart",
    "unless-stopped",
    "--stop-timeout",
    "30",
    "--name",
    "cbase-p-<pid>",
    "--hostname",
    "cbp-0",
    "--label",
    "cbase.project=<pid>",
    "--label",
    "cbase.instance=main",
    "--label",
    "cbase.mounts=<hex>",
    "--label",
    "cbase.mounts.v2=<hex>",
    "--network",
    "cbase-pn-<pid>",
    "--ip",
    "10.230.0.2",
    "-e",
    "CBASE_DOCKER_POOL=10.241.0.0/16",
    "-e",
    "CLAUDE_CONFIG_DIR=<root>/data-root/data/projects/<pid>/home/.claude",
    "-e",
    "CODEX_HOME=<root>/data-root/data/projects/<pid>/home/.codex",
    "-e",
    "HISTFILE=<root>/data-root/data/projects/<pid>/home/.bash_history",
    "--mount",
    "type=volume,src=cbase-p-<pid>-docker,dst=/var/lib/docker",
    "--mount",
    "type=bind,src=<project>,dst=<project>",
    "--mount",
    "type=bind,src=<root>/workspace/.mcp.json,dst=<root>/workspace/.mcp.json,readonly",
    "--mount",
    "type=bind,src=<root>/data-root/data/projects/<pid>,dst=<root>/data-root/data/projects/<pid>",
    "--mount",
    "type=bind,src=<scenario>/home/.npm,dst=<scenario>/home/.npm",
    "--mount",
    "type=bind,src=<scenario>/home/.cache/uv,dst=<scenario>/home/.cache/uv",
    "--mount",
    "type=bind,src=<scenario>/home/.cache/ms-playwright,dst=<scenario>/home/.cache/ms-playwright",
    "--mount",
    "type=bind,src=<scenario>/home/.cache/pip,dst=<scenario>/home/.cache/pip",
    "--mount",
    "type=bind,src=<scenario>/home/.gitconfig,dst=<scenario>/home/.gitconfig,readonly",
    "--mount",
    "type=bind,src=<scenario>/sys/bin,dst=<scenario>/sys/bin,readonly",
    "--mount",
    "type=bind,src=<scenario>/sys/nm,dst=<scenario>/sys/nm,readonly",
    "--mount",
    "type=bind,src=<scenario>/sys/mcp,dst=<scenario>/sys/mcp,readonly",
    "--mount",
    "type=bind,src=<scenario>/home/.claude-login,dst=<scenario>/home/.claude-login",
    "--mount",
    "type=bind,src=<root>/data-root/data/projects/<pid>/home/.local,dst=<scenario>/home/.local",
    "--mount",
    "type=bind,src=<root>/data-root/data/projects/<pid>/home/.vscode-server,dst=<scenario>/home/.vscode-server",
    "--mount",
    "type=bind,src=<scenario>/home/.claude/settings.json,dst=<root>/data-root/data/projects/<pid>/home/.claude/settings.json,readonly",
    "--mount",
    "type=bind,src=<scenario>/home/.claude/agents,dst=<root>/data-root/data/projects/<pid>/home/.claude/agents,readonly",
    "--mount",
    "type=bind,src=<scenario>/home/.codex/auth.json,dst=<root>/data-root/data/projects/<pid>/home/.codex/auth.json",
    "sha256:<hex>"
  ],
  [
    "exec",
    "-u",
    "agent",
    "<hex>",
    "docker",
    "info",
    "--format",
    "{{.Driver}}"
  ],
  [
    "exec",
    "-u",
    "agent",
    "<hex>",
    "cat",
    "/run/cbase-projectbox.status"
  ],
  [
    "exec",
    "-u",
    "agent",
    "<hex>",
    "cat",
    "/sys/fs/cgroup/cgroup.subtree_control"
  ],
  [
    "exec",
    "-u",
    "agent",
    "<hex>",
    "stat",
    "-c",
    "%d:%i",
    "--",
    "<scenario>/home/.local",
    "<scenario>/home/.vscode-server"
  ]
]
